{
  "rosaryGroups": [
    {
      "id": "opening",
      "title": "No início",
      "description": "Abrem o terço, antes do 1º mistério.",
      "prayers": [
        {
          "id": "sign-of-the-cross",
          "title": "Sinal da Cruz",
          "illustration": "oracao",
          "when": "Início e fim",
          "text": "Pelo sinal da Santa Cruz, livrai-nos, Deus, Nosso Senhor, dos nossos inimigos.\nEm nome do Pai, do Filho e do Espírito Santo. Amém."
        },
        {
          "id": "offering",
          "title": "Oferecimento",
          "illustration": "oferecimento",
          "when": "Início",
          "text": "Divino Jesus, nós vos oferecemos este terço que vamos rezar, meditando nos mistérios da nossa Redenção. Concedei-nos, por intercessão da Virgem Maria, Mãe de Deus e nossa Mãe, as virtudes que nos são necessárias para bem rezá-lo e a graça de ganharmos as indulgências desta santa devoção."
        },
        {
          "id": "creed",
          "title": "Creio",
          "illustration": "creio",
          "when": "Início · opcional",
          "text": "Creio em Deus Pai todo-poderoso, criador do céu e da terra; e em Jesus Cristo, seu único Filho, nosso Senhor; que foi concebido pelo poder do Espírito Santo; nasceu da Virgem Maria; padeceu sob Pôncio Pilatos, foi crucificado, morto e sepultado; desceu à mansão dos mortos; ressuscitou ao terceiro dia; subiu aos céus, está sentado à direita de Deus Pai todo-poderoso, donde há de vir a julgar os vivos e os mortos.\nCreio no Espírito Santo, na santa Igreja Católica, na comunhão dos santos, na remissão dos pecados, na ressurreição da carne, na vida eterna. Amém."
        }
      ]
    },
    {
      "id": "each-mystery",
      "title": "Em cada mistério",
      "description": "Repetidas nas cinco dezenas.",
      "prayers": [
        {
          "id": "our-father",
          "title": "Pai Nosso",
          "illustration": "pai-nosso",
          "when": "1 vez por mistério",
          "text": "Pai Nosso, que estais nos céus, santificado seja o vosso nome; venha a nós o vosso reino; seja feita a vossa vontade, assim na terra como no céu.\nO pão nosso de cada dia nos dai hoje; perdoai-nos as nossas ofensas, assim como nós perdoamos a quem nos tem ofendido; e não nos deixeis cair em tentação, mas livrai-nos do mal. Amém."
        },
        {
          "id": "hail-mary",
          "title": "Ave Maria",
          "illustration": "ave-maria",
          "when": "10 vezes por mistério",
          "text": "Ave Maria, cheia de graça, o Senhor é convosco; bendita sois vós entre as mulheres, e bendito é o fruto do vosso ventre, Jesus.\nSanta Maria, Mãe de Deus, rogai por nós, pecadores, agora e na hora de nossa morte. Amém."
        },
        {
          "id": "glory-be",
          "title": "Glória ao Pai",
          "illustration": "gloria",
          "when": "Fim de cada dezena",
          "text": "Glória ao Pai, ao Filho e ao Espírito Santo.\nComo era no princípio, agora e sempre. Amém."
        },
        {
          "id": "fatima-prayer",
          "title": "Ó meu Jesus",
          "illustration": "dezenas",
          "when": "Depois do Glória",
          "text": "Ó meu Jesus, perdoai-nos, livrai-nos do fogo do inferno, levai as almas todas para o céu e socorrei principalmente as que mais precisarem."
        }
      ]
    },
    {
      "id": "closing",
      "title": "No final",
      "description": "Encerram o terço, depois do 5º mistério.",
      "prayers": [
        {
          "id": "thanksgiving",
          "title": "Agradecimento",
          "illustration": "terco",
          "when": "Final",
          "text": "Infinitas graças vos damos, soberana Rainha, pelos benefícios que todos os dias recebemos de vossas mãos liberais. Dignai-vos, agora e para sempre, tomar-nos debaixo do vosso poderoso amparo e, para mais vos obrigar, vos saudamos com uma Salve Rainha."
        },
        {
          "id": "hail-holy-queen",
          "title": "Salve Rainha",
          "illustration": "salve-rainha",
          "when": "Final",
          "text": "Salve Rainha, Mãe de misericórdia, vida, doçura e esperança nossa, salve! A vós bradamos, os degredados filhos de Eva; a vós suspiramos, gemendo e chorando neste vale de lágrimas. Eia, pois, advogada nossa, esses vossos olhos misericordiosos a nós volvei; e depois deste desterro, mostrai-nos Jesus, bendito fruto do vosso ventre, ó clemente, ó piedosa, ó doce sempre Virgem Maria.\nRogai por nós, Santa Mãe de Deus,\npara que sejamos dignos das promessas de Cristo. Amém."
        }
      ]
    }
  ],
  "complementary": [
    {
      "id": "memorare",
      "title": "Lembrai-vos",
      "illustration": "m-coroacao",
      "when": "Mariana",
      "text": "Lembrai-vos, ó piíssima Virgem Maria, que nunca se ouviu dizer que algum daqueles que tenham recorrido à vossa proteção, implorado a vossa assistência e reclamado o vosso socorro fosse por vós desamparado.\nAnimado eu, pois, com igual confiança, a vós, ó Virgem entre todas singular, como a Mãe recorro, de vós me valho e, gemendo sob o peso dos meus pecados, me prostro a vossos pés.\nNão desprezeis as minhas súplicas, ó Mãe do Verbo de Deus humanado, mas dignai-vos de as ouvir propícia e de me alcançar o que vos rogo. Amém."
    },
    {
      "id": "guardian-angel",
      "title": "Santo Anjo",
      "illustration": "gozosos",
      "when": "Do dia a dia",
      "text": "Santo Anjo do Senhor, meu zeloso guardador, se a ti me confiou a piedade divina, sempre me rege, me guarda, me governa e me ilumina. Amém."
    },
    {
      "id": "act-of-contrition",
      "title": "Ato de Contrição",
      "illustration": "dolorosos-coracao",
      "when": "Do dia a dia",
      "text": "Meu Deus, eu me arrependo de todo o coração de vos ter ofendido, porque sois tão bom e amável. Prometo, com a vossa graça, esforçar-me para ser bom.\nMeu Jesus, misericórdia!"
    }
  ],
